# Server Configuration
PORT=3000

# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/beliarg_db
# For production (example):
# DATABASE_URL=postgresql://beliarg_user:your_secure_password@localhost:5432/beliarg_db

# JWT Secret Key
# Generate a strong random string for production (e.g., using: openssl rand -base64 32)
JWT_SECRET=your_super_secret_key_666

# Optional: Gemini API Key (if using AI features)
# GEMINI_API_KEY=your_gemini_api_key_here


